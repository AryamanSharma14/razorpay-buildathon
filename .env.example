# Twilio (WhatsApp dispatch — optional, mocked if absent)
TWILIO_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SendGrid (email dispatch — optional, mocked if absent)
SENDGRID_KEY=SG.xxx
SENDGRID_FROM=noreply@example.com

# App
DB_PATH=recovery.db
DEMO_MODE=true
