# Razorpay (test keys start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_yourkey
RAZORPAY_KEY_SECRET=yoursecret
RAZORPAY_WEBHOOK_SECRET=yourwebhooksecret

# Anthropic (Claude nudge generation)
